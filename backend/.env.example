# Application
PROJECT_NAME="EventEase AI"
SECRET_KEY="replace-with-a-secure-random-secret-key"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Database
# Local development default: sqlite:///./eventease.db
# Production (Cloud SQL / Supabase): postgresql://user:password@host:5432/dbname
DATABASE_URL="sqlite:///./eventease.db"

# Gemini API
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-2.5-flash"

